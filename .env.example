# Banco (Neon Postgres) - use a connection string com pooler/HTTP
DATABASE_URL="postgresql://user:password@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Autenticação (JWT) - gere com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-segredo-com-no-minimo-32-caracteres"

# Multi-tenant: tenant padrão quando o host não é um domínio customizado
DEFAULT_TENANT_SLUG="passaporteburguer"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloudflare R2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# URL pública do bucket (domínio customizado ou r2.dev), sem barra final
R2_PUBLIC_URL="https://cdn.passaporteburguer.com.br"

# Seed inicial (npm run db:seed)
SEED_ADMIN_NAME="Administrador"
SEED_ADMIN_EMAIL="admin@passaporteburguer.com.br"
SEED_ADMIN_PASSWORD="troque-esta-senha"

# Webhook PIX (usado na Camada 3)
# Segredo HMAC do gateway: header x-signature = sha256=HMAC(corpo bruto)
PIX_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# WhatsApp (Meta Cloud API) + bot de atendimento com IA
# ---------------------------------------------------------------------------
# Login via WhatsApp (fluxo invertido wa.me): número que recebe o código PASS-XXXX (55 + DDD + número, só dígitos)
STORE_WHATSAPP="5544999999999"
# "sandbox": libera após o cliente confirmar no site (só fora de produção) | "meta": exige o Webhook oficial
WHATSAPP_AUTH_MODE="meta"
# Entrega do código de login (o cliente sempre DIGITA o código no site; a validação é a mesma nos dois):
#   "window"   (padrão, grátis): o cliente abre o WhatsApp com uma mensagem pronta (abre a janela de 24 h) e o bot responde com o código
#   "template" (produção): o servidor envia o código direto por template de AUTENTICAÇÃO aprovado; o cliente não manda nada
#   "inbound"  (legado): o cliente envia PASS-XXXX e o Webhook confirma
WHATSAPP_OTP_DELIVERY="window"
# Só no modo "template": nome do template de autenticação aprovado na Meta (1 variável no corpo + botão copiar código) e idioma
WHATSAPP_OTP_TEMPLATE=""
WHATSAPP_OTP_TEMPLATE_LANG="pt_BR"
# Anti-abuso do envio de OTP (cada envio no modo "template" é uma mensagem paga):
#   Cloudflare Turnstile (grátis): sem as chaves o desafio fica desligado. Configure as DUAS em produção.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
#   Teto global de códigos enviados por dia (disjuntor de custo). Padrão 300.
OTP_DAILY_SEND_CAP="300"
# Coexistência (app WhatsApp Business): minutos que o bot se cala após o dono responder pelo celular (1 a 1440, padrão 60).
WHATSAPP_ECHO_PAUSE_MINUTES="60"

# Meta Cloud API (developers.facebook.com > seu app > WhatsApp)
# ID do número de envio (Phone number ID, NÃO o telefone)
WHATSAPP_PHONE_NUMBER_ID=""
# Token de acesso (em produção, use token permanente de usuário do sistema)
WHATSAPP_ACCESS_TOKEN=""
# App Secret do app: valida a assinatura x-hub-signature-256 do webhook
WHATSAPP_APP_SECRET=""
# Opcional: App Secret de um segundo app da Meta que use este mesmo webhook (cada app tem o seu)
WHATSAPP_APP_SECRET_2=""
# Token do handshake GET do webhook (o mesmo que você digita em "Verify token" na Meta).
# O nome antigo WHATSAPP_WEBHOOK_VERIFY_TOKEN ainda é aceito como alternativa; use só um dos dois.
WHATSAPP_VERIFY_TOKEN=""
# Número do bot (só dígitos) para o wa.me do Cardápio Rápido e do cadastro. Em teste: o número de teste da Meta.
# Vazio = usa STORE_WHATSAPP.
WHATSAPP_BUSINESS_NUMBER=""

# Bot: segredo HMAC dos links assinados (Cardápio Rápido / cadastro). Mínimo 16 caracteres.
# Gere com: openssl rand -hex 32
WHATSAPP_SESSION_SECRET=""
# Bot: chave da API do Gemini (enviada no header x-goog-api-key, nunca na URL)
GEMINI_API_KEY=""
# Bot: modelo do Gemini (opcional; aceita "models/x" ou "x"). Padrão: gemini-3.1-flash-lite.
# O gemini-2.5-flash dá 404 ("no longer available to new users") em contas novas.
# Liste os disponíveis para a sua chave: GET https://generativelanguage.googleapis.com/v1beta/models (header x-goog-api-key)
GEMINI_MODEL=""
# Bot: reserva GRATUITA (opcional). Chave de OUTRO projeto do AI Studio, sem faturamento. Só é usada quando a chave
# principal falha em todos os modelos, e só com modelos estáveis (gemini-2.5-flash-lite / gemini-2.5-flash).
GEMINI_API_KEY_FALLBACK=""

# Recuperação de senha por e-mail (Resend). Sem a chave, o código é logado no console (dev).
RESEND_API_KEY=""
RESEND_FROM="Passaporte Burguer <no-reply@seudominio.com.br>"

# Saipos (integração de pedidos) — sem SAIPOS_PARTNER_ID/SECRET/STORE_ID os pedidos ficam como DISABLED
SAIPOS_API_URL="https://order-api.saipos.com"
SAIPOS_PARTNER_ID=""
SAIPOS_SECRET=""
# Homologação: 99717
SAIPOS_STORE_ID=""
# Segredo do webhook POST /api/webhooks/saipos (enviado em x-webhook-secret ou Authorization: Bearer)
SAIPOS_WEBHOOK_SECRET=""
# UF padrão do endereço de entrega enviado ao Saipos (o checkout não coleta estado)
SAIPOS_DEFAULT_STATE="PR"
# CEP exigido pela Saipos na entrega (o checkout não coleta CEP); use o CEP da loja como fallback
SAIPOS_DEFAULT_POSTAL_CODE=""

# Asaas (Pix + cartão de crédito) — API v3
# Sandbox: https://api-sandbox.asaas.com/v3 | Produção: https://api.asaas.com/v3
ASAAS_API_URL="https://api-sandbox.asaas.com/v3"
ASAAS_API_KEY=""
# Token que você define no cadastro do webhook (Asaas envia no header asaas-access-token)
# URL do webhook: https://SEU_DOMINIO/api/webhooks/asaas
ASAAS_WEBHOOK_TOKEN=""
# Segredo do cron GET /api/cron/expire-orders (Authorization: Bearer ...). Sem ele a rota fica desligada.
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Marketing: templates do WhatsApp (aprovados na Meta) para falar FORA da janela de 24 h
# ---------------------------------------------------------------------------
# Sem o nome configurado, aquela mensagem simplesmente não sai fora das 24 h (nada quebra).
# Idioma dos templates abaixo (todos criados em Português BR)
WHATSAPP_TEMPLATE_LANG="pt_BR"
# Resgate de clientes sumidos. 4 variáveis no corpo: {{1}} nome, {{2}} lanche, {{3}} desconto, {{4}} validade
WHATSAPP_TEMPLATE_WINBACK=""
# Convite ao segundo pedido (cliente de 1 pedido só). Mesmas 4 variáveis do resgate
WHATSAPP_TEMPLATE_SECOND_ORDER=""
# Aviso de milhas vencendo. 3 variáveis: {{1}} nome, {{2}} milhas, {{3}} data
WHATSAPP_TEMPLATE_MILES_EXPIRY=""
# Retorno quando a loja reabre (opcional). 1 variável: {{1}} nome
WHATSAPP_TEMPLATE_REOPEN=""
# "true" SOMENTE se os templates de resgate/segundo pedido foram criados com CABEÇALHO DE IMAGEM
# (o sistema manda a foto do lanche favorito do cliente). Se o template não tem cabeçalho, deixe vazio.
WHATSAPP_TEMPLATE_HEADER_IMAGE=""

# ---------------------------------------------------------------------------
# Marketing: rastreio de anúncios (opcional; sem as variáveis nenhum script de terceiros é carregado)
# ---------------------------------------------------------------------------
# Meta Pixel: Gerenciador de Eventos > seu Pixel > ID (só números). Precisa de novo deploy ao mudar.
NEXT_PUBLIC_META_PIXEL_ID=""
# Google Analytics 4: Admin > Fluxos de dados > ID da métrica (G-XXXXXXXXXX). Precisa de novo deploy ao mudar.
NEXT_PUBLIC_GA_ID=""
# API de Conversões da Meta (envia a compra pelo servidor). SECRETO: nunca use NEXT_PUBLIC_ aqui.
# Gerenciador de Eventos > seu Pixel > Configurações > API de Conversões > Gerar token de acesso
META_CAPI_TOKEN=""

# ---------------------------------------------------------------------------
# Outros (opcionais)
# ---------------------------------------------------------------------------
# Link de avaliação da loja no Google (o bot envia depois de um elogio). Vazio = usa o link padrão do projeto.
GOOGLE_REVIEW_URL=""
