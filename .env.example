# Banco (Neon Postgres) - use a connection string com pooler/HTTP
DATABASE_URL="postgresql://user:password@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Autenticação (JWT) - gere com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-segredo-com-no-minimo-32-caracteres"

# Multi-tenant: tenant padrão quando o host não é um domínio customizado
DEFAULT_TENANT_SLUG="passaporteburguer"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloudflare R2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# URL pública do bucket (domínio customizado ou r2.dev), sem barra final
R2_PUBLIC_URL="https://cdn.passaporteburguer.com.br"

# Seed inicial (npm run db:seed)
SEED_ADMIN_NAME="Administrador"
SEED_ADMIN_EMAIL="admin@passaporteburguer.com.br"
SEED_ADMIN_PASSWORD="troque-esta-senha"

# Webhook PIX (usado na Camada 3)
# Segredo HMAC do gateway: header x-signature = sha256=HMAC(corpo bruto)
PIX_WEBHOOK_SECRET=""

# Login via WhatsApp (fluxo invertido wa.me)
# Número da hamburgueria que recebe o código (55 + DDD + número)
STORE_WHATSAPP="5543996098333"
# "sandbox": libera após o cliente confirmar no site | "meta": exige confirmação do Webhook oficial
WHATSAPP_AUTH_MODE="sandbox"
# WhatsApp Cloud API (Meta): token do handshake GET e App Secret (assinatura x-hub-signature-256)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
# Token de acesso e ID do número (resposta automática); o ID do payload tem prioridade
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Recuperação de senha por e-mail (Resend). Sem a chave, o código é logado no console (dev).
RESEND_API_KEY=""
RESEND_FROM="Passaporte Burguer <no-reply@seudominio.com.br>"

# Saipos (integração de pedidos) — sem SAIPOS_PARTNER_ID/SECRET/STORE_ID os pedidos ficam como DISABLED
SAIPOS_API_URL="https://order-api.saipos.com"
SAIPOS_PARTNER_ID=""
SAIPOS_SECRET=""
# Homologação: 99717
SAIPOS_STORE_ID=""
# Segredo do webhook POST /api/webhooks/saipos (enviado em x-webhook-secret ou Authorization: Bearer)
SAIPOS_WEBHOOK_SECRET=""
# UF padrão do endereço de entrega enviado ao Saipos (o checkout não coleta estado)
SAIPOS_DEFAULT_STATE="PR"
# CEP exigido pela Saipos na entrega (o checkout não coleta CEP); use o CEP da loja como fallback
SAIPOS_DEFAULT_POSTAL_CODE=""
