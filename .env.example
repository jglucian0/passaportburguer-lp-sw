# Banco (Neon Postgres) - use a connection string com pooler/HTTP
DATABASE_URL="postgresql://user:password@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Autenticação (JWT) - gere com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-segredo-com-no-minimo-32-caracteres"

# Multi-tenant: tenant padrão quando o host não é um domínio customizado
DEFAULT_TENANT_SLUG="passaporteburguer"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloudflare R2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# URL pública do bucket (domínio customizado ou r2.dev), sem barra final
R2_PUBLIC_URL="https://cdn.passaporteburguer.com.br"

# Seed inicial (npm run db:seed)
SEED_ADMIN_NAME="Administrador"
SEED_ADMIN_EMAIL="admin@passaporteburguer.com.br"
SEED_ADMIN_PASSWORD="troque-esta-senha"

# Webhook PIX (usado na Camada 3)
# Segredo HMAC do gateway: header x-signature = sha256=HMAC(corpo bruto)
PIX_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# WhatsApp (Meta Cloud API) + bot de atendimento com IA
# ---------------------------------------------------------------------------
# Login via WhatsApp (fluxo invertido wa.me): número que recebe o código PASS-XXXX (55 + DDD + número, só dígitos)
STORE_WHATSAPP="5544999999999"
# "sandbox": libera após o cliente confirmar no site (só fora de produção) | "meta": exige o Webhook oficial
WHATSAPP_AUTH_MODE="meta"

# Meta Cloud API (developers.facebook.com > seu app > WhatsApp)
# ID do número de envio (Phone number ID, NÃO o telefone)
WHATSAPP_PHONE_NUMBER_ID=""
# Token de acesso (em produção, use token permanente de usuário do sistema)
WHATSAPP_ACCESS_TOKEN=""
# App Secret do app: valida a assinatura x-hub-signature-256 do webhook
WHATSAPP_APP_SECRET=""
# Opcional: App Secret de um segundo app da Meta que use este mesmo webhook (cada app tem o seu)
WHATSAPP_APP_SECRET_2=""
# Token do handshake GET do webhook (o mesmo que você digita em "Verify token" na Meta).
# O nome antigo WHATSAPP_WEBHOOK_VERIFY_TOKEN ainda é aceito como alternativa; use só um dos dois.
WHATSAPP_VERIFY_TOKEN=""
# Número do bot (só dígitos) para o wa.me do Cardápio Rápido e do cadastro. Em teste: o número de teste da Meta.
# Vazio = usa STORE_WHATSAPP.
WHATSAPP_BUSINESS_NUMBER=""

# Bot: segredo HMAC dos links assinados (Cardápio Rápido / cadastro). Mínimo 16 caracteres.
# Gere com: openssl rand -hex 32
WHATSAPP_SESSION_SECRET=""
# Bot: chave da API do Gemini (modelo fixo no código: gemini-2.5-flash)
GEMINI_API_KEY=""

# Recuperação de senha por e-mail (Resend). Sem a chave, o código é logado no console (dev).
RESEND_API_KEY=""
RESEND_FROM="Passaporte Burguer <no-reply@seudominio.com.br>"

# Saipos (integração de pedidos) — sem SAIPOS_PARTNER_ID/SECRET/STORE_ID os pedidos ficam como DISABLED
SAIPOS_API_URL="https://order-api.saipos.com"
SAIPOS_PARTNER_ID=""
SAIPOS_SECRET=""
# Homologação: 99717
SAIPOS_STORE_ID=""
# Segredo do webhook POST /api/webhooks/saipos (enviado em x-webhook-secret ou Authorization: Bearer)
SAIPOS_WEBHOOK_SECRET=""
# UF padrão do endereço de entrega enviado ao Saipos (o checkout não coleta estado)
SAIPOS_DEFAULT_STATE="PR"
# CEP exigido pela Saipos na entrega (o checkout não coleta CEP); use o CEP da loja como fallback
SAIPOS_DEFAULT_POSTAL_CODE=""

# Asaas (Pix + cartão de crédito) — API v3
# Sandbox: https://api-sandbox.asaas.com/v3 | Produção: https://api.asaas.com/v3
ASAAS_API_URL="https://api-sandbox.asaas.com/v3"
ASAAS_API_KEY=""
# Token que você define no cadastro do webhook (Asaas envia no header asaas-access-token)
# URL do webhook: https://SEU_DOMINIO/api/webhooks/asaas
ASAAS_WEBHOOK_TOKEN=""
# Segredo do cron GET /api/cron/expire-orders (Authorization: Bearer ...). Sem ele a rota fica desligada.
CRON_SECRET=""
